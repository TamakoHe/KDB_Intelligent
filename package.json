{
  "name": "kdb_intelligent",
  "version": "1.0.0",
  "description": "Gen2/Gen3 电池状态查询与数据导出 SDK/CLI",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "kdb": "./dist/interfaces/cli/cli.js"
  },
  "files": [
    "dist",
    "config/kdb.toml",
    "config/kdb.local.example.toml",
    "README.md",
    "SKILL.md"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "kdb": "node --import tsx src/interfaces/cli/cli.ts",
    "prepack": "npm run build",
    "test:unit": "node --import tsx --test test/*.test.ts",
    "test:cli": "npm run build && node dist/interfaces/cli/cli.js --help",
    "test": "npm run typecheck && npm run test:unit && npm run test:cli"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TamakoHe/KDB_Intelligent.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/TamakoHe/KDB_Intelligent/issues"
  },
  "homepage": "https://github.com/TamakoHe/KDB_Intelligent#readme",
  "dependencies": {
    "@iarna/toml": "^3.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
